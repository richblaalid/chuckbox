      "rules": [
        { "from": "^2 Option ([AB]) \\((\\d+)\\)$", "to": "2$1($2)" },
        { "from": "^2 Option ([AB]) \\((\\d+)\\)\\(([a-z])\\)$", "to": "2$1($2)($3)" }
      ],
      "insertHeaders": []
    },
