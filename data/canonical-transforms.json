{
  "description": "Transform rules for normalizing BSA canonical requirement data. Each badge/version can have rules to rename requirement numbers and insert missing headers.",
  "standardFormat": "Top-level: 1, 2, 3 | Sub-level: 1a, 1b | Sub-sub: 1a(1) | Sub-sub-sub: 1a(1)(a) | Options: 4A, 4B | Option subs: 4A(1), 4A(1)(a)",
  "lastUpdated": "2026-02-11T00:00:00.000Z",
  "transforms": [
    {
      "badge": "Cycling",
      "version": 2026,
      "description": "Fix requirement 6 option A/B nesting structure",
      "rules": [
        { "from": "^6 Option ([AB])$", "to": "6$1" },
        { "from": "^6 Option ([AB])\\((\\d+)\\)$", "to": "6$1($2)" },
        { "from": "^6 Option ([AB])\\((\\d+)\\)\\(([a-z])\\)$", "to": "6$1($2)($3)" }
      ],
      "insertHeaders": [
        { "number": "6A", "description": "Option A—Road Biking", "insertAfter": "6" },
        { "number": "6B", "description": "Option B—Trail or Mixed Surface Biking", "insertAfter": "6A" }
      ]
    },
    {
      "badge": "Multisport",
      "version": 2026,
      "description": "Fix requirement 4 option A/B/C/D structure and naming",
      "rules": [
        { "from": "^4([ABCD])([a-c])$", "to": "4$1(1)($2)" },
        { "from": "^4([ABCD])([a-c])_2$", "to": "4$1(2)($2)" },
        { "from": "^4([ABCD])([a-c])_3$", "to": "4$1(3)($2)" },
        { "from": "^4([ABCD])\\(1\\)$", "to": "4$1(1)" },
        { "from": "^4([ABCD])c\\((\\d+)\\)$", "to": "4$1($2)" }
      ],
      "insertHeaders": [
        { "number": "4A", "description": "Option A—Triathlon: Do ALL of the following for swimming, biking, and running.", "insertAfter": "4" },
        { "number": "4B", "description": "Option B—Duathlon: Do ALL of the following for biking and running.", "insertAfter": "4A" },
        { "number": "4C", "description": "Option C—Aquathlon: Do ALL of the following for swimming and running.", "insertAfter": "4B" },
        { "number": "4D", "description": "Option D—Aquabike: Do ALL of the following for swimming and biking.", "insertAfter": "4C" }
      ]
    },
    {
      "badge": "Multisport",
      "version": 2025,
      "description": "Fix requirement 4 option structure for 2025 version",
      "rules": [
        { "from": "^4([ABCD])([a-c])$", "to": "4 Option $1 (1)($2)" },
        { "from": "^4([ABCD])([a-c])\\((\\d+)\\)$", "to": "4 Option $1 ($3)($2)" }
      ],
      "insertHeaders": [
        { "number": "4 Option A", "description": "Option A—Triathlon", "insertAfter": "4" },
        { "number": "4 Option B", "description": "Option B—Duathlon", "insertAfter": "4 Option A" },
        { "number": "4 Option C", "description": "Option C—Aquathlon", "insertAfter": "4 Option B" },
        { "number": "4 Option D", "description": "Option D—Aquabike", "insertAfter": "4 Option C" }
      ]
    },
    {
      "badge": "Golf",
      "version": 2024,
